<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_background_light">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:drawableStart="@drawable/widget_flame" android:drawablePadding="6dp" android:gravity="center_vertical"
        android:text="@string/app_name" android:textColor="#955032" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="@string/widget_heading"
        android:textColor="#30251F" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_tile_light">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:drawableStart="@drawable/widget_sunrise" android:drawablePadding="5dp" android:gravity="center_vertical"
                android:text="@string/sunrise" android:textColor="#67574D" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/widget_time_placeholder" android:textColor="#30251F" android:textSize="23sp" />
        </LinearLayout>
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_tile_light">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:drawableStart="@drawable/widget_sunset" android:drawablePadding="5dp" android:gravity="center_vertical"
                android:text="@string/sunset" android:textColor="#67574D" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/widget_time_placeholder" android:textColor="#30251F" android:textSize="23sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
